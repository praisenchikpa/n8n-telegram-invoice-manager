{
  "name": "Invoice Manager (Telegram)",
  "nodes": [
    {
      "parameters": {"updates": ["message"], "additionalFields": {}},
      "name": "Invoice Uploaded",
      "type": "n8n-nodes-base.telegramTrigger",
      "typeVersion": 1.5,
      "position": [0, 192],
      "credentials": {"telegramApi": {"name": "Telegram account"}}
    },
    {
      "parameters": {
        "conditions": {
          "options": {"caseSensitive": true, "leftValue": "", "typeValidation": "loose", "version": 2},
          "conditions": [
            {
              "id": "has-file",
              "leftValue": "={{ ($json.message.document || $json.message.photo) ? \"yes\" : \"no\" }}",
              "rightValue": "yes",
              "operator": {"type": "string", "operation": "equals"}
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "name": "Has File",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [224, 192]
    },
    {
      "parameters": {
        "resource": "file",
        "fileId": "={{ $json.message.document ? $json.message.document.file_id : $json.message.photo[$json.message.photo.length - 1].file_id }}",
        "additionalFields": {}
      },
      "name": "Download Invoice",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [448, 96],
      "credentials": {"telegramApi": {"name": "Telegram account"}}
    },
    {
      "parameters": {
        "name": "={{ $(\"Invoice Uploaded\").item.json.message.document ? $(\"Invoice Uploaded\").item.json.message.document.file_name : \"invoice-\" + $now.toFormat(\"yyyyMMdd-HHmmss\") + \".jpg\" }}",
        "driveId": {"__rl": true, "mode": "list", "value": "My Drive"},
        "folderId": {"__rl": true, "mode": "list", "value": "root", "cachedResultName": "/ (Root folder)"},
        "options": {}
      },
      "name": "Save To Drive",
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [832, 0],
      "credentials": {"googleDriveOAuth2Api": {"name": "Google Drive account"}}
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Read the attached invoice (image or PDF) and extract all the information into the required JSON structure. Telegram caption (may be empty): {{ $json.message ? $json.message.caption || \"\" : \"\" }}",
        "hasOutputParser": true,
        "needsFallback": true,
        "options": {
          "systemMessage": "You are an accurate invoice data extraction assistant. You receive a photo or PDF of an invoice, receipt or bill (any layout, any language, any currency).\n\nRead the document carefully, like an OCR system, and extract:\n- vendor: the business or person who ISSUED the invoice (the seller), not the customer\n- customer: who the invoice is billed to\n- invoice_number: the invoice / receipt / reference number\n- invoice_date and due_date: format YYYY-MM-DD when you can work it out\n- currency: ISO code (NGN, USD, EUR, GBP...). Infer from symbols such as the naira sign, $, euro or pound sign\n- subtotal, tax, total: plain numbers only, with no currency symbols or thousands separators. total is the final amount payable\n- line_items: a short single-line summary of what was bought, e.g. \"2 x Laptop stand, 1 x Delivery\"\n- payment_details: bank name, account number, payment terms or notes if shown\n- category: one word guess such as Utilities, Software, Supplies, Services, Travel, Food, Rent, Other\n\nRules: never invent values. If something is not visible, use an empty string (or 0 for numbers). Images can be blurry or rotated, so do your best to read them. Always return every field.",
          "maxIterations": 3,
          "passthroughBinaryImages": true,
          "passthroughBinaryPdfs": true
        }
      },
      "name": "Read Invoice",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [720, 320],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
      "parameters": {"modelName": "models/gemini-3.8-flash", "options": {"maxOutputTokens": 4000, "temperature": 0}},
      "name": "Gemini Invoice Reader",
      "type": "@n8n/n8n-nodes-langchain.lmChatGoogleGemini",
      "typeVersion": 1.2,
      "position": [688, 480],
      "credentials": {"googlePalmApi": {"name": "Google Gemini(PaLM) Api account"}}
    },
    {
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\"type\":\"object\",\"properties\":{\"vendor\":{\"type\":\"string\"},\"customer\":{\"type\":\"string\"},\"invoice_number\":{\"type\":\"string\"},\"invoice_date\":{\"type\":\"string\"},\"due_date\":{\"type\":\"string\"},\"currency\":{\"type\":\"string\"},\"subtotal\":{\"type\":\"number\"},\"tax\":{\"type\":\"number\"},\"total\":{\"type\":\"number\"},\"line_items\":{\"type\":\"string\"},\"payment_details\":{\"type\":\"string\"},\"category\":{\"type\":\"string\"}},\"required\":[\"vendor\",\"invoice_number\",\"invoice_date\",\"currency\",\"total\"]}"
      },
      "name": "Invoice Structure",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.3,
      "position": [816, 480]
    },
    {
      "parameters": {
        "chatId": "={{ $json.message.chat.id }}",
        "text": "Please send the invoice as a PDF or an image (photo) and I will log it for you.",
        "additionalFields": {"appendAttribution": false}
      },
      "name": "Ask For Invoice File",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [448, 288],
      "credentials": {"telegramApi": {"name": "Telegram account"}}
    },
    {
      "parameters": {"mode": "combine", "combineBy": "combineByPosition", "options": {}},
      "name": "Combine File And Data",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3.2,
      "position": [1248, 224]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const d = $json.output || {};\nconst s = (v) => (v === null || v === undefined ? '' : String(v));\nconst hasData = !!(d.vendor || d.invoice_number || d.total);\nreturn {\n  json: {\n    Vendor: s(d.vendor),\n    Customer: s(d.customer),\n    Invoice_number: s(d.invoice_number),\n    Invoice_date: s(d.invoice_date),\n    due_date: s(d.due_date),\n    currency: s(d.currency),\n    Subtotal: s(d.subtotal),\n    tax: s(d.tax),\n    total: s(d.total),\n    line_items: s(d.line_items),\n    payment_details: s(d.payment_details),\n    Category: s(d.category),\n    File_name: s($json.name),\n    Drive_link: s($json.webViewLink),\n    Date_added: new Date().toISOString().slice(0, 16).replace('T', ' '),\n    extraction_ok: hasData,\n  },\n};"
      },
      "name": "Build Row",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [944, 320]
    },
    {
      "parameters": {
        "operation": "append",
        "documentId": {"__rl": true, "mode": "id", "value": "YOUR_GOOGLE_SHEET_ID"},
        "sheetName": {"__rl": true, "mode": "name", "value": "Sheet1"},
        "columns": {
          "mappingMode": "autoMapInputData",
          "value": {},
          "matchingColumns": [],
          "attemptToConvertTypes": false,
          "convertFieldsToString": false
        },
        "options": {"handlingExtraData": "insertInNewColumn"}
      },
      "name": "Log Invoice",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.7,
      "position": [1472, 224],
      "credentials": {"googleSheetsOAuth2Api": {"name": "Google Sheets account"}}
    },
    {
      "parameters": {
        "chatId": "={{ $(\"Invoice Uploaded\").item.json.message.chat.id }}",
        "text": "={{ $(\"Build Row\").item.json.extraction_ok ? \"Invoice saved\" : \"Invoice file saved, but I could not read the details clearly - please check the sheet\" }}\n\nVendor: {{ $(\"Build Row\").item.json.Vendor || \"-\" }}\nCustomer: {{ $(\"Build Row\").item.json.Customer || \"-\" }}\nInvoice #: {{ $(\"Build Row\").item.json.Invoice_number || \"-\" }}\nInvoice date: {{ $(\"Build Row\").item.json.Invoice_date || \"-\" }}\nDue date: {{ $(\"Build Row\").item.json.due_date || \"-\" }}\nSubtotal: {{ $(\"Build Row\").item.json.Subtotal || \"-\" }}\nTax: {{ $(\"Build Row\").item.json.tax || \"-\" }}\nTotal: {{ $(\"Build Row\").item.json.currency }} {{ $(\"Build Row\").item.json.total || \"-\" }}\nCategory: {{ $(\"Build Row\").item.json.Category || \"-\" }}\nItems: {{ $(\"Build Row\").item.json.line_items || \"-\" }}\n\nSaved to Google Sheets and Drive.\nInvoice file: {{ $(\"Build Row\").item.json.Drive_link }}",
        "additionalFields": {"appendAttribution": false, "disable_web_page_preview": true}
      },
      "name": "Send Summary",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [1696, 224],
      "credentials": {"telegramApi": {"name": "Telegram account"}}
    },
    {
      "parameters": {"model": "qwen/qwen3-14b", "options": {}},
      "name": "OpenRouter Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenRouter",
      "typeVersion": 1,
      "position": [688, 816],
      "credentials": {"openRouterApi": {"name": "OpenRouter account"}}
    }
  ],
  "connections": {
    "Invoice Uploaded": {"main": [[{"node": "Has File", "type": "main", "index": 0}]]},
    "Has File": {"main": [[{"node": "Download Invoice", "type": "main", "index": 0}], [{"node": "Ask For Invoice File", "type": "main", "index": 0}]]},
    "Download Invoice": {"main": [[{"node": "Save To Drive", "type": "main", "index": 0}, {"node": "Read Invoice", "type": "main", "index": 0}]]},
    "Save To Drive": {"main": [[{"node": "Combine File And Data", "type": "main", "index": 0}]]},
    "Read Invoice": {"main": [[{"node": "Combine File And Data", "type": "main", "index": 1}]]},
    "Gemini Invoice Reader": {"ai_languageModel": [[{"node": "Read Invoice", "type": "ai_languageModel", "index": 0}]]},
    "Invoice Structure": {"ai_outputParser": [[{"node": "Read Invoice", "type": "ai_outputParser", "index": 0}]]},
    "Combine File And Data": {"main": [[{"node": "Build Row", "type": "main", "index": 0}]]},
    "Build Row": {"main": [[{"node": "Log Invoice", "type": "main", "index": 0}]]},
    "Log Invoice": {"main": [[{"node": "Send Summary", "type": "main", "index": 0}]]},
    "OpenRouter Chat Model": {"ai_languageModel": [[{"node": "Read Invoice", "type": "ai_languageModel", "index": 1}]]}
  },
  "settings": {"executionOrder": "v1", "binaryMode": "separate"},
  "meta": {"templateCredsSetupCompleted": false}
}
